# Modelo de configuração. Não contém credenciais utilizáveis.
# Compose lê .env; Spring Boot NÃO o carrega automaticamente.
MSSQL_SA_PASSWORD=
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=atividade5;encrypt=true;trustServerCertificate=true;loginTimeout=5;socketTimeout=10000
DB_USERNAME=sa
DB_PASSWORD=
# Base64 de pelo menos 32 bytes aleatórios; nunca reutilize senha como chave.
JWT_SECRET=
JWT_TTL_SECONDS=900
CORS_ALLOWED_ORIGIN=http://localhost:4200
LOGIN_RATE_LIMIT=10
DEMO_USER_ENABLED=false
DEMO_USER_EMAIL=aluno@example.com
DEMO_USER_PASSWORD=
